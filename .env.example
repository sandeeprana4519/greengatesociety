# ==============================================================================
# Society Marketplace — Environment Configuration Template
# Never commit real secrets, private keys, or service-account JSON files.
# ==============================================================================

# --- AI Studio / Server-Side Gemini (optional) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- Admin Dashboard (Next.js Web SDK) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# --- Customer Mobile App (Expo / React Native) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_ID=

# --- Cloud Functions & Local Admin Bootstrap Script ---
# Use Google Application Default Credentials (gcloud auth application-default login)
# or GOOGLE_APPLICATION_CREDENTIALS pointing to a local file OUTSIDE the repository.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
ADMIN_BOOTSTRAP_UID=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=

# --- Firebase Emulator Suite (Local Testing Only) ---
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
