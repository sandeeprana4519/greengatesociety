{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated customer or staff profile linked to a residential society.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "phoneNumber": { "type": "string", "minLength": 0, "maxLength": 20 },
        "email": { "type": "string", "minLength": 0, "maxLength": 160 },
        "alternateContact": { "type": "string", "minLength": 0, "maxLength": 20 },
        "societyId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "flatId": { "type": "string", "minLength": 0, "maxLength": 64 },
        "flatNumber": { "type": "string", "minLength": 0, "maxLength": 32 },
        "tower": { "type": "string", "minLength": 0, "maxLength": 64 },
        "residentType": { "type": "string", "enum": ["Owner", "Tenant"] },
        "addressConfirmed": { "type": "boolean" },
        "accountType": { "type": "string", "enum": ["customer", "admin", "staff", "vendor"] },
        "membershipStatus": {
          "type": "string",
          "enum": ["not_submitted", "unverified", "pending", "approved", "rejected", "suspended"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended", "blocked"]
        },
        "rejectionReason": { "type": "string", "minLength": 0, "maxLength": 240 },
        "suspensionReason": { "type": "string", "minLength": 0, "maxLength": 240 },
        "infoRequestNote": { "type": "string", "minLength": 0, "maxLength": 300 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string", "minLength": 0, "maxLength": 128 },
        "approvalAcknowledged": { "type": "boolean" },
        "fcmToken": { "type": "string", "minLength": 0, "maxLength": 512 },
        "preferredLocale": { "type": "string", "enum": ["en", "hi"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "membershipStatus", "accountStatus", "createdAt", "updatedAt"]
    },
    "Society": {
      "title": "Society",
      "description": "Residential society tenant root entity.",
      "type": "object",
      "properties": {
        "societyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "societyName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "address": { "type": "string", "minLength": 2, "maxLength": 300 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "state": { "type": "string", "minLength": 2, "maxLength": 80 },
        "pincode": { "type": "string", "pattern": "^[0-9]{6}$", "minLength": 6, "maxLength": 6 },
        "invitationCode": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "towers": { "type": "array" },
        "totalFlats": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
