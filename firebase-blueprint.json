        "residentType": { "type": "string", "enum": ["Owner", "Tenant"] },
        "phoneNumber": { "type": "string", "minLength": 0, "maxLength": 20 },
        "email": { "type": "string", "minLength": 0, "maxLength": 160 },
        "alternateContact": { "type": "string", "minLength": 0, "maxLength": 20 },
        "addressConfirmed": { "type": "boolean" },
        "invitationCode": { "type": "string", "minLength": 0, "maxLength": 64 },
        "invitationCodeId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "verificationStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "rejectionReason": { "type": "string", "minLength": 0, "maxLength": 240 },
        "suspensionReason": { "type": "string", "minLength": 0, "maxLength": 240 },
        "infoRequestNote": { "type": "string", "minLength": 0, "maxLength": 300 },
