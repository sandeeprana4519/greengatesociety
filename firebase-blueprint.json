        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["societyId", "societyName", "address", "city", "state", "pincode", "invitationCode", "status", "createdAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Legacy Phase 1 invitation metadata (admin/server read-only in Phase 2).",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "societyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "societyName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "societyId", "societyName", "city", "active", "createdAt"]
    },
    "InvitationCode": {
      "title": "InvitationCode",
      "description": "Admin/server-only hashed society invitation code record with expiry and usage caps.",
      "type": "object",
      "properties": {
        "codeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "societyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "societyName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "codeHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "codePreview": { "type": "string", "minLength": 2, "maxLength": 16 },
        "status": { "type": "string", "enum": ["active", "inactive", "revoked", "expired"] },
        "expiresAt": { "type": "string", "minLength": 0, "maxLength": 64 },
        "maxUses": { "type": "integer" },
        "usedCount": { "type": "integer" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["codeId", "societyId", "societyName", "city", "codeHash", "status", "maxUses", "usedCount", "createdBy", "createdAt", "updatedAt"]
    },
    "InvitationLookup": {
      "title": "InvitationLookup",
      "description": "SHA-256 hash keyed lookup projection (get-only, never listable, contains no plaintext code or PII).",
      "type": "object",
      "properties": {
        "codeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "societyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "societyName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "inactive", "revoked", "expired"] },
        "expiresAt": { "type": "string", "minLength": 0, "maxLength": 64 },
        "maxUses": { "type": "integer" },
        "usedCount": { "type": "integer" }
      },
      "required": ["codeId", "societyId", "societyName", "city", "status", "maxUses", "usedCount"]
    },
